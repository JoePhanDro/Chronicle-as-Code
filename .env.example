# Kopiere diese Datei nach .env und setze Werte. .env wird nicht versioniert.
# Ohne Benutzername und Passwort legt der Server keinen Admin an; dann per admin_cli anlegen.
CHRONICLE_ADMIN_USER=admin
CHRONICLE_ADMIN_PASSWORD=
# Domainname, für den der Proxy antwortet (Standard localhost, docs/betrieb-tls.md). Mit CHRONICLE_TLS=acme holt Caddy dafür ein Zertifikat.
# Zertifikatsquelle: leer = certs/cert.pem + certs/key.pem falls vorhanden, sonst selbst signiert. Oder files, internal, acme.
CHRONICLE_TLS=
CHRONICLE_HOSTNAME=localhost
# Benachrichtigungen (Issue #258): ohne Secret/Host bleiben Webhook bzw. E-Mail deaktiviert.
# Webhook-URL und E-Mail-Empfänger werden pro Topic in der Oberfläche konfiguriert, nicht hier.
CHRONICLE_WEBHOOK_SECRET=
CHRONICLE_SMTP_HOST=
CHRONICLE_SMTP_PORT=587
CHRONICLE_SMTP_STARTTLS=1
CHRONICLE_SMTP_SSL=0
CHRONICLE_SMTP_USER=
CHRONICLE_SMTP_PASSWORD=
CHRONICLE_SMTP_FROM=
CHRONICLE_NOTIFY_COOLDOWN_SECONDS=60
CHRONICLE_BASE_URL=
