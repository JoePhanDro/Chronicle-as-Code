# TLS reverse proxy in front of the Chronicle API. See docs/betrieb-tls.md.
# The site address comes from CHRONICLE_HOSTNAME, the certificate source from CHRONICLE_TLS (set by proxy-entrypoint.sh).
# Port 80 only redirects to HTTPS.

(tls-files) {
	tls /certs/cert.pem /certs/key.pem
}

(tls-internal) {
	tls internal
}

# Caddy's default: a real certificate for a public domain.
(tls-acme) {
}

{$CHRONICLE_HOSTNAME:localhost} {
	import tls-{$CHRONICLE_TLS:internal}
	encode zstd gzip

	# Defense in depth behind the app's own limit (CHRONICLE_MAX_BODY_BYTES, default 112 MiB):
	# a request that declares a Content-Length of ten or more digits (>= 1 GB) is answered 413
	# before it reaches the API at all.
	@oversized header_regexp Content-Length ^[0-9]{10,}$
	route {
		error @oversized 413
		reverse_proxy api:8000
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}
}
