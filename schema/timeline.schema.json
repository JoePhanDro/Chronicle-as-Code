{
  "$defs": {
    "Detection": {
      "additionalProperties": false,
      "description": "The detection that led to this event (issue #257): which rule or alert in the SIEM/EDR, at which rule\nversion. Chronicle does not detect anything itself; it only records what the detecting system reported.\nAt least rule_id or alert_id must be set.",
      "properties": {
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "rule_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Name"
        },
        "rule_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Version"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "alert_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alert Id"
        }
      },
      "title": "Detection",
      "type": "object"
    },
    "EmailConfig": {
      "additionalProperties": false,
      "description": "E-mail channel of a topic (issue #258): recipients are stored here, the SMTP server and credentials\ncome from the environment (CHRONICLE_SMTP_*), so no secrets land in the YAML files that are in Git.",
      "properties": {
        "to": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "To",
          "type": "array"
        },
        "triggers": {
          "items": {
            "enum": [
              "new_event",
              "status_change",
              "new_evidence",
              "rule_match"
            ],
            "type": "string"
          },
          "title": "Triggers",
          "type": "array"
        }
      },
      "required": [
        "to"
      ],
      "title": "EmailConfig",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Stable, globally unique key. Re-importing the same key updates the event.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "title": "Key",
          "type": "string"
        },
        "t0": {
          "description": "ISO 8601 timestamp with timezone offset",
          "format": "date-time",
          "title": "T0",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System"
        },
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "triggered_by": {
          "description": "Keys of the events that caused this event. Any number, including none (issue #87)",
          "items": {
            "type": "string"
          },
          "title": "Triggered By",
          "type": "array"
        },
        "techniques": {
          "description": "MITRE ATT&CK technique IDs, e.g. T1190 or T1059.001. Any number, including none (ADR 0026)",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Techniques",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Tags",
          "type": "array"
        },
        "detection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detection"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The rule/alert that led to this event (issue #257), if any"
        },
        "comments": {
          "items": {
            "$ref": "#/$defs/EventComment"
          },
          "maxItems": 200,
          "title": "Comments",
          "type": "array"
        },
        "details": {
          "default": "",
          "description": "Markdown body shown in the detail view",
          "title": "Details",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "key",
        "t0",
        "phase",
        "actor",
        "action",
        "status"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventComment": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "author": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "text": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "author",
        "text"
      ],
      "title": "EventComment",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "Path relative to the timeline.yaml folder",
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "type": {
          "enum": [
            "screenshot",
            "log",
            "report",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "file",
        "type"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "IncidentClassification": {
      "additionalProperties": false,
      "description": "The classification of an incident topic (issue #225): severity, TLP for sharing reports, impact,\nroot cause and measures. Every field is optional; a topic without the block is unchanged. The levels are\nfixed (like Status and Phase), not configurable per instance.",
      "properties": {
        "severity": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "tlp": {
          "anyOf": [
            {
              "enum": [
                "CLEAR",
                "GREEN",
                "AMBER",
                "RED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tlp"
        },
        "impact": {
          "default": "",
          "title": "Impact",
          "type": "string"
        },
        "affected_systems": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Affected Systems",
          "type": "array"
        },
        "data_categories": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Data Categories",
          "type": "array"
        },
        "affected_persons": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "geschätzte Zahl der Betroffenen",
          "title": "Affected Persons"
        },
        "cause": {
          "default": "",
          "title": "Cause",
          "type": "string"
        },
        "measures": {
          "default": "",
          "title": "Measures",
          "type": "string"
        }
      },
      "title": "IncidentClassification",
      "type": "object"
    },
    "Notifications": {
      "additionalProperties": false,
      "description": "The notification channels of a topic (issue #258). Delivery is active per trigger; the secrets\n(webhook HMAC, SMTP credentials) live in the environment, not in the topic file.",
      "properties": {
        "webhook": {
          "anyOf": [
            {
              "$ref": "#/$defs/WebhookConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "email": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Notifications",
      "type": "object"
    },
    "Phase": {
      "enum": [
        "Identification",
        "Exploit",
        "Analysis",
        "Containment",
        "Mitigation",
        "Recovery",
        "Lessons Learned",
        "Activity"
      ],
      "title": "Phase",
      "type": "string"
    },
    "Reporting": {
      "additionalProperties": false,
      "description": "The reporting obligation of a topic (issue #229): legal basis and the moment the incident became known.\nThe stage deadlines (Frühwarnung, Meldung, Abschlussbericht) follow from the regulation and can be\noverridden per topic in hours. Chronicle only shows the deadlines and builds the reports, it never sends.",
      "properties": {
        "regulation": {
          "enum": [
            "nis2",
            "bsig",
            "dora",
            "dsgvo",
            "other"
          ],
          "title": "Regulation",
          "type": "string"
        },
        "known_at": {
          "description": "Zeitpunkt der Kenntnisnahme, ISO 8601 mit Zeitzone",
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "deadlines": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Eigene Fristen pro Stufe in Stunden ab Kenntnisnahme, z. B. {'notification': 48}",
          "title": "Deadlines",
          "type": "object"
        }
      },
      "required": [
        "regulation",
        "known_at"
      ],
      "title": "Reporting",
      "type": "object"
    },
    "Status": {
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "title": "Status",
      "type": "string"
    },
    "Topic": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "title": "Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "default": "other",
          "enum": [
            "incident",
            "vulnerability",
            "project",
            "special",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "reporting": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reporting"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Meldepflicht des Topics (issue #229)"
        },
        "notifications": {
          "anyOf": [
            {
              "$ref": "#/$defs/Notifications"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Benachrichtigungskanäle des Topics (issue #258)"
        },
        "incident": {
          "anyOf": [
            {
              "$ref": "#/$defs/IncidentClassification"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Klassifikation des Incidents (issue #225)"
        }
      },
      "required": [
        "key",
        "title"
      ],
      "title": "Topic",
      "type": "object"
    },
    "WebhookConfig": {
      "additionalProperties": false,
      "description": "Webhook channel of a topic (issue #258): the URL is stored here, the HMAC secret comes from the\nenvironment (CHRONICLE_WEBHOOK_SECRET) and never lands in the YAML files that are in Git.",
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "triggers": {
          "items": {
            "enum": [
              "new_event",
              "status_change",
              "new_evidence",
              "rule_match"
            ],
            "type": "string"
          },
          "title": "Triggers",
          "type": "array"
        }
      },
      "required": [
        "url"
      ],
      "title": "WebhookConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One topic file: the topic, the events it defines and references to events defined elsewhere.",
  "properties": {
    "topic": {
      "$ref": "#/$defs/Topic"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "refs": {
      "description": "Keys of events defined in other topic files",
      "items": {
        "type": "string"
      },
      "title": "Refs",
      "type": "array"
    }
  },
  "required": [
    "topic"
  ],
  "title": "Timeline",
  "type": "object"
}
