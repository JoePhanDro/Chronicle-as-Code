{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "description": "Stable, globally unique key. Re-importing the same key updates the event.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "title": "Key",
          "type": "string"
        },
        "t0": {
          "description": "ISO 8601 timestamp with timezone offset",
          "format": "date-time",
          "title": "T0",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "actor": {
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System"
        },
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "triggered_by": {
          "description": "Keys of the events that caused this event. Any number, including none (issue #87)",
          "items": {
            "type": "string"
          },
          "title": "Triggered By",
          "type": "array"
        },
        "techniques": {
          "description": "MITRE ATT&CK technique IDs, e.g. T1190 or T1059.001. Any number, including none (ADR 0026)",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Techniques",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Tags",
          "type": "array"
        },
        "comments": {
          "items": {
            "$ref": "#/$defs/EventComment"
          },
          "maxItems": 200,
          "title": "Comments",
          "type": "array"
        },
        "details": {
          "default": "",
          "description": "Markdown body shown in the detail view",
          "title": "Details",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "key",
        "t0",
        "phase",
        "actor",
        "action",
        "status"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventComment": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "author": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "text": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "author",
        "text"
      ],
      "title": "EventComment",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "Path relative to the timeline.yaml folder",
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "type": {
          "enum": [
            "screenshot",
            "log",
            "report",
            "other"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "file",
        "type"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Phase": {
      "enum": [
        "Identification",
        "Exploit",
        "Analysis",
        "Containment",
        "Mitigation",
        "Recovery",
        "Lessons Learned",
        "Activity"
      ],
      "title": "Phase",
      "type": "string"
    },
    "Status": {
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "title": "Status",
      "type": "string"
    },
    "Topic": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
          "title": "Key",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "default": "other",
          "enum": [
            "incident",
            "vulnerability",
            "project",
            "special",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "key",
        "title"
      ],
      "title": "Topic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One topic file: the topic, the events it defines and references to events defined elsewhere.",
  "properties": {
    "topic": {
      "$ref": "#/$defs/Topic"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "refs": {
      "description": "Keys of events defined in other topic files",
      "items": {
        "type": "string"
      },
      "title": "Refs",
      "type": "array"
    }
  },
  "required": [
    "topic"
  ],
  "title": "Timeline",
  "type": "object"
}
